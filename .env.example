# Copy to `.env` (or `.env.local`) and fill in. All values are optional;
# analytics hooks do nothing if their ID is missing.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=

# Meta (Facebook/Instagram) Pixel ID
VITE_META_PIXEL_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
VITE_GTM_ID=

# WhatsApp number in international format without "+" or spaces, e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# Frontend → API (dev: use /api with Vite proxy; production: full URL e.g. https://bipminds.com/api)
VITE_API_BASE_URL=/api

# Catalogue: auto (try API, fallback mock) | api | mock
VITE_CATALOG_SOURCE=auto

# ---- Backend (server/) — copy to .env, never commit .env ----
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Hostinger MySQL (hPanel → Databases → Remote MySQL). From your laptop use the remote hostname, not localhost.
DB_HOST=
DB_PORT=3306
DB_USER=u168471611_ouat
DB_NAME=u168471611_ouat
DB_PASSWORD=

# JWT signing secret — use at least 32 random characters; never commit the real value
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Admin users: create in DB only — npm run db:seed-admin -- email@example.com 'password'
# Access /admin when users.role = admin (see Admin → Team)

# Razorpay (server-side; optional if saved in Admin → Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Delhivery B2C (One Panel → Settings → API setup → API token)
# staging | production | mock (mock fakes every call). Staging and production use different tokens.
DELHIVERY_ENV=staging
DELHIVERY_API_TOKEN=
# Warehouse name exactly as registered with Delhivery (case and space sensitive)
DELHIVERY_PICKUP_LOCATION=
# Surface | Express
DELHIVERY_SHIPPING_MODE=Surface
# Pickup slot requested each day (IST, hh:mm:ss)
DELHIVERY_PICKUP_TIME=14:00:00
# Package defaults used for every order (grams / cm)
DELHIVERY_DEFAULT_WEIGHT_G=500
DELHIVERY_DEFAULT_LENGTH_CM=20
DELHIVERY_DEFAULT_BREADTH_CM=15
DELHIVERY_DEFAULT_HEIGHT_CM=10
# 4R (4x6) | A4
DELHIVERY_LABEL_SIZE=4R
DELHIVERY_SELLER_NAME=
# Token Delhivery sends to /api/webhooks/courier-tracking (Authorization: Bearer <token>)
DELHIVERY_WEBHOOK_TOKEN=

# Order emails (confirmation + invoice PDF, bottle passport) sent over SMTP when an order is confirmed.
# Leave SMTP_HOST empty to turn emails off. Port 465 → SMTP_SECURE=true; 587 → false (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. "O.U.A.T. <orders@ouatworld.com>"
MAIL_FROM=
# Optional: where customer replies go
MAIL_REPLY_TO=
# New-order notifications for the store owner; comma-separated for several addresses, empty = off
STORE_OWNER_EMAIL=
# Environment: local or production (default production).
#   local      → every link we generate (emails, passports, password reset, canonical tags on the
#                Vite dev server) points at LOCAL_SITE_URL, and email subjects get a [LOCAL] prefix.
#   production → links point at SITE_URL. Always use production on the live server.
APP_ENV=production
# Public live site address
SITE_URL=https://ouatworld.com
# Your local storefront (the Vite dev server), used when APP_ENV=local
LOCAL_SITE_URL=http://localhost:5173
# Optional: printed on the invoice PDF
SELLER_GSTIN=

# Local dev only: the deployed site's address (e.g. https://shop.example.com). Product photos uploaded
# there are saved on that server, not in the DB, so locally /uploads/... is fetched from here instead.
# Leave empty on the deployed server itself.
MEDIA_BASE_URL=

# Instagram posts in the home page "From the studio" grid (server-side only; never prefix with VITE_).
# Leave the token empty to show the static tiles. How to get it:
#   1. Make @ouat_goa a Business or Creator account (Instagram app → Settings → Account type).
#   2. developers.facebook.com → My Apps → Create app (type "Business") → add the "Instagram" product
#      → "API setup with Instagram login" → add @ouat_goa under "Generate access tokens" and log in.
#   3. Copy the long-lived token it shows (valid 60 days; the server refreshes it daily while running).
INSTAGRAM_ACCESS_TOKEN=
# Optional: the Instagram user ID shown next to the token. Empty = the token's own account ("me").
INSTAGRAM_USER_ID=
# How long to keep posts before asking Instagram again (minutes)
INSTAGRAM_CACHE_MINUTES=60

# Number of proxies in front of the API (Hostinger runs Node behind one), so rate limits see the
# visitor's real IP. Empty = 1 when APP_ENV=production, off when APP_ENV=local. Use 0 to turn off.
TRUST_PROXY=

# Where photos uploaded in Admin are saved. On the LIVE server this must be a folder OUTSIDE the app
# folder, e.g. /home/u168471611/ouat-uploads (hPanel → File Manager shows your home path at the top).
# Every deploy replaces the app folder, so photos saved inside it are deleted. Photo URLs stay
# /uploads/... either way. Empty = public/uploads inside the app (fine for local development only).
UPLOAD_DIR=
