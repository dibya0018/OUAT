{
  "name": "ouat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch --import ./server/devApiOnlyEnv.js server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:procedures": "node server/scripts/install-procedures-cli.js",
    "db:test": "node server/scripts/test-db.js",
    "db:apply": "node server/scripts/apply-db.js",
    "db:seed": "node server/scripts/seed-catalog.js",
    "db:seed-admin": "node server/scripts/seed-admin.js",
    "catalog:sync-images": "node server/scripts/sync-catalog-images.js",
    "catalog:import-website-xlsx": "xlsx-cli \"website details .xlsx\" --json -o server/data/website-details.json",
    "build": "vite build",
    "start": "node server.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "6.3.5"
  }
}
